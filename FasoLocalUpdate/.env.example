# ─── HOW TO USE THIS FILE ──────────────────────────────────────────────────────
#
#   Local dev:  cp .env.example .env   → fill in your DEV Supabase project values
#
#   CI/CD injects values automatically from GitHub Secrets:
#     Staging (develop branch) → VITE_SUPABASE_URL_STAGING + VITE_SUPABASE_ANON_KEY_STAGING
#     Production (main branch) → VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY
#
#   Required GitHub Secrets (Settings → Secrets and variables → Actions):
#     VITE_SUPABASE_URL              — prod Supabase project URL
#     VITE_SUPABASE_ANON_KEY         — prod Supabase anon key
#     VITE_SUPABASE_URL_STAGING      — staging Supabase project URL
#     VITE_SUPABASE_ANON_KEY_STAGING — staging Supabase anon key
#     VERCEL_TOKEN                   — Vercel deploy token
#     VERCEL_ORG_ID                  — Vercel org ID
#     VERCEL_PROJECT_ID              — Vercel project ID
#
# ─── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── App ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME=FasoLocal
VITE_APP_URL=http://localhost:3000

# ─── CinetPay (Phase 2 — leave blank until payment integration) ────────────────
# These go in Supabase Dashboard → Edge Functions → Secrets (NOT in .env)
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_NOTIFY_URL=https://your-project-ref.supabase.co/functions/v1/payment-webhook
# CINETPAY_RETURN_URL=https://fasolocal.com/commande/confirmation
