generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  role           Role      @default(CUSTOMER)
  addresses      Address[]
  orders         Order[]
  reviews        Review[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  fullName     String
  phone        String
  street       String
  quartier     String
  city         String
  region       String?
  country      String  @default("Burkina Faso")
  isDefault    Boolean @default(false)
  instructions String?
  orders       Order[]
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  description      String
  shortDescription String
  price            Int            // in FCFA
  compareAtPrice   Int?
  category         ProductCategory
  subcategory      String?
  tags             String[]
  stock            Int            @default(0)
  isAvailable      Boolean        @default(true)
  isFeatured       Boolean        @default(false)
  isNew            Boolean        @default(false)
  weight           Int?           // grams
  origin           String
  producerId       String?
  producer         Producer?      @relation(fields: [producerId], references: [id])
  images           ProductImage[]
  orderItems       OrderItem[]
  reviews          Review[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([category])
  @@index([slug])
}

enum ProductCategory {
  agroalimentaire
  cosmetiques
  artisanat
  textiles
  sante_bien_etre
  boissons
  cereales_farines
  epices_condiments
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  isPrimary Boolean @default(false)
}

model Producer {
  id       String    @id @default(cuid())
  name     String
  location String
  bio      String?
  avatar   String?
  products Product[]
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  shippingAddressId String
  shippingAddress Address       @relation(fields: [shippingAddressId], references: [id])
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PENDING)
  subtotal        Int
  deliveryFee     Int
  total           Int
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  productName  String
  productImage String
  price        Int
  quantity     Int
  total        Int
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

enum PaymentMethod {
  ORANGE_MONEY
  MOOV_MONEY
  CORIS_MONEY
  VISA
  MASTERCARD
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
